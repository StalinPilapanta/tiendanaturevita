# Nombre que se muestra en la tienda
MARCA=NatureVita EC
# WhatsApp de ventas en formato internacional, sin + ni espacios (ej. 593991234567)
WHATSAPP_NUMERO=593984721899
# Aviso de cada pedido nuevo a Telegram (puede ser el mismo bot y grupo de ventas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Clave para que el bot de ventas lea los pedidos (cadena larga y aleatoria)
TIENDA_API_KEY=
# Prefijo del numero de pedido (NV-1001, NV-1002...)
PEDIDO_PREFIJO=NV
# Carpeta de datos (SQLite). En Coolify montar un volumen persistente en /data
DATA_DIR=/data
# Redes sociales (URL completa con https://). Las vacias no se muestran.
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=
